rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/profiles/$(uid);
    }

    function rolePath(uid) {
      return /databases/$(database)/documents/roles/$(uid);
    }

    function myProfile() {
      return get(profilePath(request.auth.uid)).data;
    }

    function roleName() {
      return exists(rolePath(request.auth.uid))
        ? get(rolePath(request.auth.uid)).data.role
        : 'student';
    }

    function isStaff() {
      return signedIn() && roleName() in ['warden', 'admin', 'faculty', 'verifier'];
    }

    function isVerifier() {
      return signedIn() && roleName() in ['admin', 'warden', 'faculty'];
    }

    function sameCampus(campusKey) {
      return signedIn()
        && myProfile().universityKey == campusKey;
    }

    function staffForCampus(campusKey) {
      return isStaff() && sameCampus(campusKey);
    }

    function verifierForCampus(campusKey) {
      return isVerifier() && sameCampus(campusKey);
    }

    function canPublishAcademic() {
      return signedIn() && roleName() == 'faculty';
    }

    function canManageHostel() {
      return signedIn() && roleName() in ['warden', 'admin'];
    }

    function canManageGroups() {
      return signedIn() && roleName() in ['warden', 'faculty', 'admin'];
    }

    function canCreateChannel(kind) {
      return signedIn() && (
        (roleName() == 'faculty' && kind in ['class', 'subject', 'club'])
        || (roleName() == 'warden' && kind in ['hostel', 'club'])
        || (roleName() == 'admin' && kind in ['class', 'subject', 'hostel', 'campus', 'club'])
      );
    }

    function channelDoc(channelId) {
      return /databases/$(database)/documents/channels/$(channelId);
    }

    function conversationDocPath(conversationId) {
      return /databases/$(database)/documents/conversations/$(conversationId);
    }

    function canCheckNewDirectConversation(conversationId) {
      // The client checks whether a deterministic two-person conversation exists
      // before creating it. Permit that existence check only for an ID containing
      // the signed-in UID, and only for a fully verified campus member. A missing
      // document contains no conversation data to disclose.
      return signedIn()
        && myProfile().profileComplete == true
        && myProfile().membershipStatus == 'verified'
        && myProfile().universityKey is string
        && myProfile().universityKey.size() > 0
        && (conversationId.matches('^' + request.auth.uid + '_[^_]+$')
          || conversationId.matches('^[^_]+_' + request.auth.uid + '$'));
    }

    function channelMemberDoc(channelId, uid) {
      return /databases/$(database)/documents/channelMemberships/$(channelId + '_' + uid);
    }

    function verifiedCampusStudent(uid, campusKey) {
      return exists(profilePath(uid))
        && get(profilePath(uid)).data.universityKey == campusKey
        && get(profilePath(uid)).data.profileComplete == true
        && get(profilePath(uid)).data.membershipStatus == 'verified';
    }

    // Firestore Rules cannot loop over a list. These explicit checks support groups
    // of up to eight members while verifying every member against a campus profile.
    function validCampusParticipants(p, campusKey) {
      return p is list && (
        (p.size() == 2
          && verifiedCampusStudent(p[0], campusKey)
          && verifiedCampusStudent(p[1], campusKey))
        ||
        (p.size() == 3
          && verifiedCampusStudent(p[0], campusKey)
          && verifiedCampusStudent(p[1], campusKey)
          && verifiedCampusStudent(p[2], campusKey))
        ||
        (p.size() == 4
          && verifiedCampusStudent(p[0], campusKey)
          && verifiedCampusStudent(p[1], campusKey)
          && verifiedCampusStudent(p[2], campusKey)
          && verifiedCampusStudent(p[3], campusKey))
        ||
        (p.size() == 5
          && verifiedCampusStudent(p[0], campusKey)
          && verifiedCampusStudent(p[1], campusKey)
          && verifiedCampusStudent(p[2], campusKey)
          && verifiedCampusStudent(p[3], campusKey)
          && verifiedCampusStudent(p[4], campusKey))
        ||
        (p.size() == 6
          && verifiedCampusStudent(p[0], campusKey)
          && verifiedCampusStudent(p[1], campusKey)
          && verifiedCampusStudent(p[2], campusKey)
          && verifiedCampusStudent(p[3], campusKey)
          && verifiedCampusStudent(p[4], campusKey)
          && verifiedCampusStudent(p[5], campusKey))
        ||
        (p.size() == 7
          && verifiedCampusStudent(p[0], campusKey)
          && verifiedCampusStudent(p[1], campusKey)
          && verifiedCampusStudent(p[2], campusKey)
          && verifiedCampusStudent(p[3], campusKey)
          && verifiedCampusStudent(p[4], campusKey)
          && verifiedCampusStudent(p[5], campusKey)
          && verifiedCampusStudent(p[6], campusKey))
        ||
        (p.size() == 8
          && verifiedCampusStudent(p[0], campusKey)
          && verifiedCampusStudent(p[1], campusKey)
          && verifiedCampusStudent(p[2], campusKey)
          && verifiedCampusStudent(p[3], campusKey)
          && verifiedCampusStudent(p[4], campusKey)
          && verifiedCampusStudent(p[5], campusKey)
          && verifiedCampusStudent(p[6], campusKey)
          && verifiedCampusStudent(p[7], campusKey))
      );
    }

    match /roles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // Roles are assigned only by the project owner in the Firebase Console.
      allow write: if false;
    }

    match /profiles/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.membershipStatus == 'pending';

      allow read: if signedIn() && (
        request.auth.uid == uid
        || (sameCampus(resource.data.universityKey)
          && myProfile().membershipStatus == 'verified'
          && resource.data.membershipStatus == 'verified')
        || staffForCampus(resource.data.universityKey)
      );

      // Explicit staff list permission for campus-scoped student approval queries.
      // The query must constrain universityKey to the signed-in staff member's campus.
      allow list: if signedIn()
        && isVerifier()
        && resource.data.universityKey == myProfile().universityKey;

      // A student can edit their own personal details, but cannot change their
      // university membership, verification state, UID, role or creation time.
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.profileComplete == resource.data.profileComplete
          && request.resource.data.universityKey == resource.data.universityKey
          && request.resource.data.membershipStatus == resource.data.membershipStatus
          && request.resource.data.emailVerified == request.auth.token.email_verified
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'email', 'emailVerified', 'phone', 'collegeId', 'department', 'degree', 'degreeKey',
            'course', 'courseKey', 'year', 'hostel', 'hostelKey', 'room', 'bio', 'profileComplete', 'universityShortName',
            'updatedAt'
          ])
        )
        ||
        // Migrate accounts created by the previous starter release.
        (request.auth.uid == uid
          && !resource.data.keys().hasAny(['universityKey'])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.membershipStatus == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['universityKey', 'membershipStatus', 'updatedAt']))
        ||
        // A newly registered user may complete the campus name/key once.
        (request.auth.uid == uid
          && resource.data.profileComplete != true
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.membershipStatus == 'pending'
          && request.resource.data.profileComplete == true
          && request.resource.data.emailVerified == request.auth.token.email_verified
          && request.resource.data.universityKey is string
          && request.resource.data.universityKey.size() > 0
          && request.resource.data.name is string && request.resource.data.name.size() > 0
          && request.resource.data.university is string && request.resource.data.university.size() > 0
          && request.resource.data.collegeId is string && request.resource.data.collegeId.size() > 0
          && request.resource.data.department is string && request.resource.data.department.size() > 0
          && request.resource.data.course is string && request.resource.data.course.size() > 0
          && request.resource.data.year is number
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'email', 'emailVerified', 'phone', 'collegeId', 'university', 'universityShortName', 'universityKey',
            'department', 'degree', 'degreeKey', 'course', 'courseKey', 'year', 'hostel', 'hostelKey', 'room', 'bio', 'profileComplete', 'updatedAt'
          ]))
        ||
        // A pre-authorised staff account can publish its assigned role to its campus profile
        // and becomes eligible for staff tools only after completing its own profile.
        (request.auth.uid == uid
          && staffForCampus(resource.data.universityKey)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.universityKey == resource.data.universityKey
          && request.resource.data.profileComplete == true
          && request.resource.data.role == roleName()
          && request.resource.data.membershipStatus == 'verified'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role', 'membershipStatus', 'membershipReviewedBy', 'membershipReviewedAt', 'updatedAt'
          ]))
        ||
        // Destination-campus staff can apply a transfer only after approving
        // the matching campusChangeRequests document.
        (staffForCampus(request.resource.data.universityKey)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.membershipStatus == 'pending'
          && request.resource.data.lastCampusTransferId is string
          && exists(/databases/$(database)/documents/campusChangeRequests/$(request.resource.data.lastCampusTransferId))
          && get(/databases/$(database)/documents/campusChangeRequests/$(request.resource.data.lastCampusTransferId)).data.status == 'approved'
          && get(/databases/$(database)/documents/campusChangeRequests/$(request.resource.data.lastCampusTransferId)).data.studentUid == uid
          && request.resource.data.universityKey != resource.data.universityKey
          && get(/databases/$(database)/documents/campusChangeRequests/$(request.resource.data.lastCampusTransferId)).data.requestedUniversityKey == request.resource.data.universityKey
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'university', 'universityKey', 'lastCampusTransferId', 'membershipStatus',
            'membershipReviewedBy', 'membershipReviewedAt', 'updatedAt'
          ]))
        ||
        // Only a Warden, Faculty member or Administrator from this campus can verify a student.
        (verifierForCampus(resource.data.universityKey)
          && resource.data.membershipStatus == 'pending'
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.universityKey == resource.data.universityKey
          && request.resource.data.profileComplete == true
          && request.resource.data.membershipStatus in ['verified', 'rejected']
          && request.resource.data.membershipReviewedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'membershipStatus', 'membershipReviewedBy', 'membershipReviewedAt', 'updatedAt'
          ]))
      );

      allow delete: if false;
    }

    match /campusChangeRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && myProfile().profileComplete == true
        && myProfile().membershipStatus == 'verified'
        && request.resource.data.currentUniversityKey == myProfile().universityKey
        && request.resource.data.requestedUniversityKey is string
        && request.resource.data.requestedUniversityKey.size() > 0
        && request.resource.data.requestedUniversityKey != myProfile().universityKey
        && request.resource.data.status == 'pending';

      allow read: if signedIn() && (
        resource.data.studentUid == request.auth.uid
        || staffForCampus(resource.data.requestedUniversityKey)
      );

      allow update: if verifierForCampus(resource.data.requestedUniversityKey)
        && resource.data.status == 'pending'
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.requestedUniversityKey == resource.data.requestedUniversityKey
        && request.resource.data.currentUniversityKey == resource.data.currentUniversityKey
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedBy', 'reviewedAt'
        ]);

      allow delete: if false;
    }

    match /applications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.universityKey == myProfile().universityKey
        && request.resource.data.status == 'pending';

      allow read: if signedIn() && (
        resource.data.studentUid == request.auth.uid
        || (resource.data.keys().hasAny(['universityKey']) && staffForCampus(resource.data.universityKey))
        || (isStaff() && resource.data.university == myProfile().university)
      );

      allow update: if signedIn() && (
        (resource.data.studentUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.studentUid == resource.data.studentUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'cancelledAt']))
        ||
        (((resource.data.keys().hasAny(['universityKey']) && staffForCampus(resource.data.universityKey))
          || (isVerifier() && resource.data.university == myProfile().university))
          && resource.data.status == 'pending'
          && request.resource.data.studentUid == resource.data.studentUid
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.status in ['approved', 'rejected', 'escalated']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'reviewComment', 'reviewedBy', 'updatedAt', 'history'
          ]))
      );

      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.universityKey == myProfile().universityKey
        && request.resource.data.type in ['direct', 'group']
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 8
        && validCampusParticipants(request.resource.data.participants, request.resource.data.universityKey)
        && (
          (request.resource.data.type == 'direct' && request.resource.data.participants.size() == 2)
          ||
          (request.resource.data.type == 'group'
            && request.resource.data.admins is list
            && request.resource.data.admins.size() >= 1
            && request.resource.data.participants.hasAll(request.resource.data.admins)
            && request.auth.uid in request.resource.data.admins)
        );

      // Existing conversation documents are readable only by participants on
      // the same campus. Keep list queries provable with participants + universityKey.
      allow list: if signedIn()
        && resource.data.keys().hasAny(['universityKey'])
        && sameCampus(resource.data.universityKey)
        && ((request.auth.uid in resource.data.participants
          && (myProfile().membershipStatus == 'verified' || isStaff()))
          || roleName() == 'admin');

      // A direct-chat starter first checks its deterministic pair ID. Firestore
      // rules cannot evaluate participant fields on a missing document, so permit
      // only the non-existent pair lookup whose ID includes this verified user's UID.
      allow get: if signedIn() && (
        (exists(conversationDocPath(conversationId))
          && resource.data.keys().hasAny(['universityKey'])
          && sameCampus(resource.data.universityKey)
          && ((request.auth.uid in resource.data.participants
            && (myProfile().membershipStatus == 'verified' || isStaff()))
            || roleName() == 'admin'))
        || (!exists(conversationDocPath(conversationId))
          && canCheckNewDirectConversation(conversationId))
      );

      // Any participant can update last-message metadata. Only group admins
      // can rename a group, add/remove users or change the admin list.
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && (
          (resource.data.keys().hasAny(['universityKey'])
            && sameCampus(resource.data.universityKey)
            && validCampusParticipants(resource.data.participants, resource.data.universityKey)
            && (
              (request.resource.data.participants == resource.data.participants
                && request.resource.data.admins == resource.data.admins
                && request.resource.data.groupName == resource.data.groupName
                && request.resource.data.type == resource.data.type
                && request.resource.data.universityKey == resource.data.universityKey
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'lastMessage', 'lastMessageAt', 'updatedAt'
                ]))
              ||
              (resource.data.type == 'group'
                && request.auth.uid in resource.data.admins
                && request.resource.data.type == 'group'
                && request.resource.data.universityKey == resource.data.universityKey
                && request.resource.data.participants.size() >= 2
                && request.resource.data.participants.size() <= 8
                && validCampusParticipants(request.resource.data.participants, resource.data.universityKey)
                && request.resource.data.admins is list
                && request.resource.data.admins.size() >= 1
                && request.resource.data.participants.hasAll(request.resource.data.admins)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'groupName', 'participants', 'admins', 'memberNames', 'updatedAt'
                ]))
            ))
          ||
          // One-time migration of direct chats created by the previous starter release.
          (!resource.data.keys().hasAny(['universityKey'])
            && resource.data.university == myProfile().university
            && resource.data.participants.size() == 2
            && validCampusParticipants(resource.data.participants, myProfile().universityKey)
            && request.resource.data.type == 'direct'
            && request.resource.data.universityKey == myProfile().universityKey
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'type', 'groupName', 'admins', 'memberNames', 'universityKey', 'updatedAt'
            ]))
        );

      allow delete: if signedIn()
        && sameCampus(resource.data.universityKey)
        && ((resource.data.type == 'group' && request.auth.uid in resource.data.admins)
          || roleName() == 'admin');

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        function isConversationMember() {
          return signedIn()
            && request.auth.uid in parentConversation().participants
            && parentConversation().keys().hasAny(['universityKey'])
            && sameCampus(parentConversation().universityKey)
            && (myProfile().membershipStatus == 'verified' || isStaff());
        }

        allow read: if isConversationMember()
          || (signedIn() && roleName() == 'admin' && sameCampus(parentConversation().universityKey));

        allow create: if isConversationMember()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && request.resource.data.readBy is list
          && request.resource.data.readBy.hasOnly([request.auth.uid]);

        allow update: if (isConversationMember() && (
          (resource.data.senderUid == request.auth.uid
            && resource.data.deleted != true
            && request.resource.data.senderUid == resource.data.senderUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'text', 'edited', 'deleted', 'updatedAt'
            ]))
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
            && request.resource.data.readBy is list
            && (!resource.data.keys().hasAny(['readBy']) || request.resource.data.readBy.hasAll(resource.data.readBy))
            && request.auth.uid in request.resource.data.readBy)
        )) || (signedIn() && roleName() == 'admin'
          && sameCampus(parentConversation().universityKey)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived', 'archivedAt', 'archivedBy']));

        allow delete: if (isConversationMember()
          && parentConversation().type == 'group'
          && request.auth.uid in parentConversation().admins)
          || (signedIn() && roleName() == 'admin'
            && sameCampus(parentConversation().universityKey));
      }
    }

    match /notices/{noticeId} {
      allow read: if signedIn()
        && ((resource.data.keys().hasAny(['universityKey']) && sameCampus(resource.data.universityKey))
          || resource.data.university == myProfile().university)
        && (myProfile().membershipStatus == 'verified' || isStaff());
      allow create: if isVerifier()
        && request.resource.data.universityKey == myProfile().universityKey
        && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isVerifier()
        && sameCampus(resource.data.universityKey);
    }

    // Faculty-owned teaching content. Students can read only records for their campus.
    match /academicItems/{itemId} {
      allow read: if signedIn()
        && resource.data.universityKey == myProfile().universityKey
        && (myProfile().membershipStatus == 'verified' || isStaff());
      allow create: if canPublishAcademic()
        && request.resource.data.universityKey == myProfile().universityKey
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.type in ['assignment', 'coursework', 'academic'];
      allow update, delete: if signedIn()
        && sameCampus(resource.data.universityKey)
        && (roleName() == 'admin' || (roleName() == 'faculty' && resource.data.authorUid == request.auth.uid));
    }

    // Attendance is written by faculty/admin and visible to the student concerned or campus staff.
    match /attendanceRecords/{recordId} {
      allow read: if signedIn() && (
        resource.data.studentUid == request.auth.uid
        || staffForCampus(resource.data.universityKey)
      );
      allow create: if canPublishAcademic()
        && request.resource.data.universityKey == myProfile().universityKey
        && request.resource.data.markedBy == request.auth.uid
        && request.resource.data.studentUid is string
        && verifiedCampusStudent(request.resource.data.studentUid, myProfile().universityKey)
        && request.resource.data.status in ['present', 'absent', 'late', 'excused'];
      allow update: if canPublishAcademic()
        && sameCampus(resource.data.universityKey)
        && request.resource.data.universityKey == resource.data.universityKey
        && request.resource.data.markedBy == request.auth.uid;
      allow delete: if roleName() == 'admin' && sameCampus(resource.data.universityKey);
    }

    // Only the university administration publishes official holidays and shared timetable entries.
    match /campusCalendar/{entryId} {
      allow read: if signedIn()
        && resource.data.universityKey == myProfile().universityKey
        && (myProfile().membershipStatus == 'verified' || isStaff());
      allow create: if signedIn() && roleName() == 'admin'
        && request.resource.data.universityKey == myProfile().universityKey
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && roleName() == 'admin'
        && sameCampus(resource.data.universityKey);
    }

    match /communityPosts/{postId} {
      allow read: if signedIn()
        && resource.data.universityKey == myProfile().universityKey
        && (myProfile().membershipStatus == 'verified' || isStaff());
      allow create: if signedIn()
        && myProfile().membershipStatus == 'verified'
        && request.resource.data.universityKey == myProfile().universityKey
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1800;
      allow update, delete: if signedIn()
        && sameCampus(resource.data.universityKey)
        && (resource.data.authorUid == request.auth.uid || roleName() == 'admin');
    }

    match /events/{eventId} {
      allow read: if signedIn()
        && resource.data.universityKey == myProfile().universityKey
        && (myProfile().membershipStatus == 'verified' || isStaff());
      allow create: if canManageGroups()
        && request.resource.data.universityKey == myProfile().universityKey
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn()
        && sameCampus(resource.data.universityKey)
        && (roleName() == 'admin' || resource.data.createdBy == request.auth.uid);
    }

    match /clubs/{clubId} {
      allow read: if signedIn()
        && resource.data.universityKey == myProfile().universityKey
        && (myProfile().membershipStatus == 'verified' || isStaff());
      allow create: if canManageGroups()
        && request.resource.data.universityKey == myProfile().universityKey
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && sameCampus(resource.data.universityKey)
        && (roleName() == 'admin' || resource.data.createdBy == request.auth.uid)
        && request.resource.data.universityKey == resource.data.universityKey
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'category', 'description', 'openToJoin', 'updatedAt']);
      allow delete: if signedIn() && roleName() == 'admin'
        && sameCampus(resource.data.universityKey);
    }

    match /clubMemberships/{membershipId} {
      allow read: if signedIn() && (
        resource.data.studentUid == request.auth.uid
        || staffForCampus(resource.data.universityKey)
      );
      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.universityKey == myProfile().universityKey
        && myProfile().membershipStatus == 'verified'
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/clubs/$(request.resource.data.clubId))
        && get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.universityKey == myProfile().universityKey
        && get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.openToJoin == true;
      allow update: if staffForCampus(resource.data.universityKey)
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.clubId == resource.data.clubId
        && request.resource.data.status in ['active', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt']);
      allow delete: if signedIn() && (request.auth.uid == resource.data.studentUid || staffForCampus(resource.data.universityKey));
    }

    match /eventRsvps/{rsvpId} {
      allow read: if signedIn() && (resource.data.studentUid == request.auth.uid || staffForCampus(resource.data.universityKey));
      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.universityKey == myProfile().universityKey
        && myProfile().membershipStatus == 'verified';
      allow update, delete: if signedIn() && (resource.data.studentUid == request.auth.uid || roleName() == 'admin')
        && sameCampus(resource.data.universityKey);
    }

    // Channel metadata, memberships and messages are separate from direct-message conversations.
    // This permits class-size groups without the 8-person limit used by legacy direct chats.
    match /channels/{channelId} {
      allow read: if signedIn()
        && resource.data.universityKey == myProfile().universityKey
        && (myProfile().membershipStatus == 'verified' || isStaff());
      allow create: if canCreateChannel(request.resource.data.kind)
        && request.resource.data.universityKey == myProfile().universityKey
        && request.resource.data.createdByUid == request.auth.uid;
      allow update: if signedIn() && sameCampus(resource.data.universityKey)
        && (roleName() == 'admin' || resource.data.createdByUid == request.auth.uid)
        && request.resource.data.universityKey == resource.data.universityKey
        && request.resource.data.createdByUid == resource.data.createdByUid;
      allow delete: if signedIn() && roleName() == 'admin'
        && sameCampus(resource.data.universityKey);

      match /messages/{messageId} {
        function channelMemberActive() {
          return signedIn()
            && exists(channelMemberDoc(channelId, request.auth.uid))
            && get(channelMemberDoc(channelId, request.auth.uid)).data.status == 'active';
        }
        function channelStaff() {
          return signedIn()
            && get(channelDoc(channelId)).data.universityKey == myProfile().universityKey
            && isStaff();
        }
        allow read: if channelMemberActive() || channelStaff();
        allow create: if (channelMemberActive() || channelStaff())
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;
        allow update: if ((channelMemberActive() || channelStaff())
          && resource.data.senderUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'updatedAt']))
          || (signedIn() && roleName() == 'admin' && channelStaff()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived', 'archivedAt', 'archivedBy']));
        allow delete: if signedIn() && roleName() == 'admin' && channelStaff();
      }
    }

    match /channelMemberships/{membershipId} {
      allow read: if signedIn() && (
        resource.data.userUid == request.auth.uid
        || staffForCampus(resource.data.campusKey)
      );
      allow create: if signedIn()
        && request.resource.data.userUid is string
        && request.resource.data.channelId is string
        && request.resource.data.campusKey == myProfile().universityKey
        && exists(channelDoc(request.resource.data.channelId))
        && get(channelDoc(request.resource.data.channelId)).data.universityKey == myProfile().universityKey
        && (
          (staffForCampus(request.resource.data.campusKey)
            && (request.resource.data.userUid == request.auth.uid
              || verifiedCampusStudent(request.resource.data.userUid, request.resource.data.campusKey))
            && request.resource.data.status == 'active')
          ||
          (request.resource.data.userUid == request.auth.uid
            && request.resource.data.status == 'pending'
            && get(channelDoc(request.resource.data.channelId)).data.kind == 'club'
            && exists(/databases/$(database)/documents/clubs/$(get(channelDoc(request.resource.data.channelId)).data.clubId))
            && get(/databases/$(database)/documents/clubs/$(get(channelDoc(request.resource.data.channelId)).data.clubId)).data.openToJoin == true)
          ||
          (request.resource.data.userUid == request.auth.uid
            && request.resource.data.status == 'active'
            && myProfile().profileComplete == true
            && myProfile().membershipStatus == 'verified'
            && get(channelDoc(request.resource.data.channelId)).data.kind in ['class', 'subject', 'hostel', 'campus']
            && get(channelDoc(request.resource.data.channelId)).data.enrollmentMode == 'auto'
            && (get(channelDoc(request.resource.data.channelId)).data.kind == 'campus'
              || (((!get(channelDoc(request.resource.data.channelId)).data.keys().hasAny(['departmentKey'])
                  && (!get(channelDoc(request.resource.data.channelId)).data.keys().hasAny(['department'])
                    || get(channelDoc(request.resource.data.channelId)).data.department == ''
                    || get(channelDoc(request.resource.data.channelId)).data.department == myProfile().department))
                || (get(channelDoc(request.resource.data.channelId)).data.keys().hasAny(['departmentKey'])
                  && (get(channelDoc(request.resource.data.channelId)).data.departmentKey == ''
                    || (myProfile().keys().hasAny(['degreeKey']) && get(channelDoc(request.resource.data.channelId)).data.departmentKey == myProfile().degreeKey)
                    || get(channelDoc(request.resource.data.channelId)).data.department == myProfile().department)))
              && ((!get(channelDoc(request.resource.data.channelId)).data.keys().hasAny(['courseKey'])
                  && (!get(channelDoc(request.resource.data.channelId)).data.keys().hasAny(['course'])
                    || get(channelDoc(request.resource.data.channelId)).data.course == ''
                    || get(channelDoc(request.resource.data.channelId)).data.course == myProfile().course))
                || (get(channelDoc(request.resource.data.channelId)).data.keys().hasAny(['courseKey'])
                  && (get(channelDoc(request.resource.data.channelId)).data.courseKey == ''
                    || (myProfile().keys().hasAny(['courseKey']) && get(channelDoc(request.resource.data.channelId)).data.courseKey == myProfile().courseKey)
                    || get(channelDoc(request.resource.data.channelId)).data.course == myProfile().course)))
              && (!get(channelDoc(request.resource.data.channelId)).data.keys().hasAny(['year'])
                || get(channelDoc(request.resource.data.channelId)).data.year == null
                || get(channelDoc(request.resource.data.channelId)).data.year == myProfile().year)
              && ((!get(channelDoc(request.resource.data.channelId)).data.keys().hasAny(['hostelKey'])
                  && (!get(channelDoc(request.resource.data.channelId)).data.keys().hasAny(['hostel'])
                    || get(channelDoc(request.resource.data.channelId)).data.hostel == ''
                    || get(channelDoc(request.resource.data.channelId)).data.hostel == myProfile().hostel))
                || (get(channelDoc(request.resource.data.channelId)).data.keys().hasAny(['hostelKey'])
                  && (get(channelDoc(request.resource.data.channelId)).data.hostelKey == ''
                    || (myProfile().keys().hasAny(['hostelKey']) && get(channelDoc(request.resource.data.channelId)).data.hostelKey == myProfile().hostelKey)
                    || get(channelDoc(request.resource.data.channelId)).data.hostel == myProfile().hostel))))))
          ||
          (request.resource.data.userUid == request.auth.uid
            && request.resource.data.status == 'active'
            && myProfile().profileComplete == true
            && myProfile().membershipStatus == 'verified'
            && get(channelDoc(request.resource.data.channelId)).data.kind in ['class', 'subject']
            && get(channelDoc(request.resource.data.channelId)).data.enrollmentMode == 'featured'
            && ((!get(channelDoc(request.resource.data.channelId)).data.keys().hasAny(['departmentKey'])
                && (!get(channelDoc(request.resource.data.channelId)).data.keys().hasAny(['department'])
                  || get(channelDoc(request.resource.data.channelId)).data.department == myProfile().department))
              || (get(channelDoc(request.resource.data.channelId)).data.keys().hasAny(['departmentKey'])
                && ((myProfile().keys().hasAny(['degreeKey']) && get(channelDoc(request.resource.data.channelId)).data.departmentKey == myProfile().degreeKey)
                  || get(channelDoc(request.resource.data.channelId)).data.department == myProfile().department)))
            && ((!get(channelDoc(request.resource.data.channelId)).data.keys().hasAny(['courseKey'])
                && (!get(channelDoc(request.resource.data.channelId)).data.keys().hasAny(['course'])
                  || get(channelDoc(request.resource.data.channelId)).data.course == myProfile().course))
              || (get(channelDoc(request.resource.data.channelId)).data.keys().hasAny(['courseKey'])
                && ((myProfile().keys().hasAny(['courseKey']) && get(channelDoc(request.resource.data.channelId)).data.courseKey == myProfile().courseKey)
                  || get(channelDoc(request.resource.data.channelId)).data.course == myProfile().course)))
            && (!get(channelDoc(request.resource.data.channelId)).data.keys().hasAny(['year'])
              || get(channelDoc(request.resource.data.channelId)).data.year == null
              || get(channelDoc(request.resource.data.channelId)).data.year == myProfile().year))
        );
      allow update: if staffForCampus(resource.data.campusKey)
        && request.resource.data.userUid == resource.data.userUid
        && request.resource.data.channelId == resource.data.channelId
        && request.resource.data.campusKey == resource.data.campusKey
        && request.resource.data.status in ['active', 'pending', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if signedIn() && (roleName() == 'admin' || request.auth.uid == resource.data.userUid)
        && sameCampus(resource.data.campusKey);
    }

    match /hostelAllocations/{allocationId} {
      allow read: if signedIn() && (resource.data.studentUid == request.auth.uid || (canManageHostel() && sameCampus(resource.data.universityKey)));
      allow create: if canManageHostel()
        && request.resource.data.universityKey == myProfile().universityKey
        && request.resource.data.createdBy == request.auth.uid
        && verifiedCampusStudent(request.resource.data.studentUid, myProfile().universityKey);
      allow update, delete: if canManageHostel() && sameCampus(resource.data.universityKey);
    }

    // Restrictions disable NeonVerse access; they do not delete or disable the Firebase Auth account.
    match /userModeration/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || (roleName() == 'admin' && sameCampus(resource.data.universityKey)));
      allow create: if signedIn() && roleName() == 'admin'
        && request.resource.data.universityKey == myProfile().universityKey
        && request.resource.data.userUid == uid;
      allow update: if signedIn() && roleName() == 'admin'
        && sameCampus(resource.data.universityKey)
        && request.resource.data.universityKey == myProfile().universityKey
        && request.resource.data.userUid == uid;
      allow delete: if signedIn() && roleName() == 'admin' && sameCampus(resource.data.universityKey);
    }

    match /notifications/{recipientUid}/items/{notificationId} {
      allow read: if signedIn() && request.auth.uid == recipientUid;
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.universityKey == myProfile().universityKey
        && exists(profilePath(recipientUid))
        && (
          get(profilePath(recipientUid)).data.universityKey == myProfile().universityKey
          || (request.resource.data.type == 'membership'
            && isVerifier()
            && request.resource.data.requestId is string
            && exists(/databases/$(database)/documents/campusChangeRequests/$(request.resource.data.requestId))
            && get(/databases/$(database)/documents/campusChangeRequests/$(request.resource.data.requestId)).data.studentUid == recipientUid
            && get(/databases/$(database)/documents/campusChangeRequests/$(request.resource.data.requestId)).data.requestedUniversityKey == myProfile().universityKey
            && get(/databases/$(database)/documents/campusChangeRequests/$(request.resource.data.requestId)).data.status in ['approved', 'rejected'])
        );
      allow update: if signedIn()
        && request.auth.uid == recipientUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if signedIn() && request.auth.uid == recipientUid;
    }

    match /aiWorkHistory/{historyId} {
      allow create: if signedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.universityKey == myProfile().universityKey
        && request.resource.data.role == roleName();
      allow read: if signedIn()
        && resource.data.actorUid == request.auth.uid
        && resource.data.universityKey == myProfile().universityKey;
      allow update, delete: if false;
    }

    // Append-only results from real, non-mutating Agent37 evaluation probes.
    // Only campus admins may create and read their campus evaluation records.
    match /agent37EvaluationRuns/{runId} {
      allow create: if signedIn()
        && roleName() == 'admin'
        && request.resource.data.keys().hasOnly([
          'testId', 'testCase', 'category', 'expectedOutcome', 'actualOutcome', 'status',
          'durationMs', 'source', 'actorUid', 'actorName', 'actorRole', 'universityKey', 'createdAt'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() <= 120
        && request.resource.data.actorRole == 'admin'
        && request.resource.data.universityKey == myProfile().universityKey
        && request.resource.data.testId in ['identity-consistency', 'role-write-denied', 'unauthenticated-route', 'role-escalation', 'cross-campus-filter']
        && request.resource.data.status in ['passed', 'failed', 'blocked']
        && request.resource.data.category in ['policy', 'reliability']
        && request.resource.data.testId is string
        && request.resource.data.testId.size() <= 80
        && request.resource.data.testCase is string
        && request.resource.data.testCase.size() <= 180
        && request.resource.data.expectedOutcome is string
        && request.resource.data.expectedOutcome.size() <= 500
        && request.resource.data.actualOutcome is string
        && request.resource.data.actualOutcome.size() <= 1000
        && request.resource.data.durationMs is int
        && request.resource.data.durationMs >= 0
        && request.resource.data.source in ['firestore-client', '/api/agent37-work']
        && request.resource.data.createdAt == request.time;
      allow read: if signedIn()
        && roleName() == 'admin'
        && resource.data.universityKey == myProfile().universityKey;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
