rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }
    function sameUniversity(university) {
      return signedIn() && myProfile().university == university;
    }
    function hasRole(role) {
      return signedIn() &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == role;
    }
    function staff() {
      return signedIn() &&
        (get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role in ['warden','admin','faculty']);
    }
    function validConversationMembers(participants, university) {
      return participants.size() == 2
        && get(/databases/$(database)/documents/profiles/$(participants[0])).data.university == university
        && get(/databases/$(database)/documents/profiles/$(participants[1])).data.university == university;
    }

    match /roles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // Roles must be assigned manually by a trusted project owner in Firebase Console.
      allow write: if false;
    }

    match /profiles/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student';
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        (resource.data.university == myProfile().university)
      );
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /applications/{appId} {
      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.university == myProfile().university
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && (
        resource.data.studentUid == request.auth.uid ||
        (staff() && sameUniversity(resource.data.university))
      );
      allow update: if signedIn() && (
        (resource.data.studentUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.studentUid == resource.data.studentUid
          && request.resource.data.university == resource.data.university
          && request.resource.data.status == resource.data.status)
        ||
        (staff() && sameUniversity(resource.data.university)
          && request.resource.data.studentUid == resource.data.studentUid
          && request.resource.data.university == resource.data.university)
      );
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && sameUniversity(request.resource.data.university)
        && validConversationMembers(request.resource.data.participants, request.resource.data.university);
      allow read: if signedIn()
        && request.auth.uid in resource.data.participants
        && sameUniversity(resource.data.university)
        && validConversationMembers(resource.data.participants, resource.data.university);
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.university == resource.data.university
        && sameUniversity(resource.data.university)
        && validConversationMembers(resource.data.participants, resource.data.university);
      allow delete: if false;
      match /messages/{messageId} {
        function conversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        allow read: if signedIn()
          && request.auth.uid in conversation().participants
          && sameUniversity(conversation().university);
        allow create: if signedIn()
          && request.auth.uid in conversation().participants
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.receiverUid in conversation().participants
          && sameUniversity(conversation().university);
        allow update, delete: if false;
      }
    }

    match /notices/{noticeId} {
      allow read: if signedIn() && sameUniversity(resource.data.university);
      allow create: if staff()
        && request.resource.data.university == myProfile().university;
      allow update, delete: if staff() && sameUniversity(resource.data.university);
    }

    match /activity/{activityId} {
      allow create: if signedIn() && request.resource.data.actorUid == request.auth.uid;
      allow read: if staff() && sameUniversity(myProfile().university);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
